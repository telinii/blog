# Copie para `.env` na raiz e ajuste antes de `docker compose up --build`.
# O `.env` é ignorado pelo git.

# Obrigatório: assina os JWT. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Credenciais do MySQL do compose (troque em produção).
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=bloggers
MYSQL_USER=blog
MYSQL_PASSWORD=blog

# URL das capas vista pelo navegador. Se publicar num domínio/host, troque
# pelo endereço público da API (ex.: https://api.seudominio.com).
PUBLIC_API_URL=http://localhost:3000

# Ligue (1) só atrás de proxy reverso: faz o rate limit usar o IP real
# enviado em X-Forwarded-For.
TRUST_PROXY=0
