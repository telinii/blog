# URL da API usada pelo SERVIDOR do Next (Server Components e Server Actions).
# Não precisa de NEXT_PUBLIC_: o token nunca vai para o browser.
API_URL=http://localhost:3000

# URL usada no HTML para as capas (quem baixa a imagem é o navegador).
# Só é necessário quando difere da API_URL — no Docker a API é
# http://backend:3000 (rede interna) e o browser não resolve esse nome.
# PUBLIC_API_URL=http://localhost:3000
