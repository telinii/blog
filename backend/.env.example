# Required database: MySQL 8.x or MariaDB 10.x/11.x

DATABASE_URL="mysql://blog_user:<YOUR_PASSWORD>@localhost:3306/bloggers"
JWT_SECRET="<YOUR_JWT_SECRET>"

# Banco isolado da suite de testes (npm test aplica as migrations e usa este)
DATABASE_URL_TEST="mysql://blog_user:<YOUR_PASSWORD>@localhost:3306/bloggers_test"

# Rate limit (opcional; valores abaixo sao os padroes)
# LOGIN_RATE_LIMIT_MAX=5
# CADASTRO_RATE_LIMIT_MAX=10

# Ligue apenas atras de um proxy (Railway, Nginx): usa o IP de X-Forwarded-For
# TRUST_PROXY=1
